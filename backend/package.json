{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Unified Node.js, Express & MongoDB Backend for Multi-Vendor E-Commerce Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node -e \"import('./config/db.js').then(m => m.connectDB()).then(() => import('./utils/seedDatabase.js')).then(m => m.seedDatabase()).then(() => process.exit(0))\"",
    "seed:admin": "node utils/seedAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
